{
  "name": "databricks-waf-assessment",
  "version": "0.1.0",
  "main": "dist/server.js",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "description": "Assess a Databricks workspace against all seven pillars of the Well-Architected Framework.",
  "author": "Databricks, Inc.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "bundle:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "bundle:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "bundle": "npm run bundle:server && npm run bundle:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:live": "node scripts/test-live.mjs",
    "verify": "node scripts/verify.mjs",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebundle": "npm run sync",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "seed:catalogue": "node scripts/seed-catalogue.mjs",
    "validate:catalogue": "node scripts/validate-catalogue.mjs",
    "enrich:catalogue": "node scripts/enrich-catalogue.mjs",
    "check:counts": "node scripts/check-counts.mjs",
    "check:read-only": "node scripts/check-read-only.mjs",
    "check:evidence-script": "node scripts/check-evidence-script.mjs",
    "check:supervision": "node scripts/check-supervision.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:plan-status": "node scripts/check-plan-status.mjs",
    "check:baseline-table": "node scripts/publish-baseline-table.mjs --check",
    "check:read-paths": "node scripts/measure-read-paths.mjs --check",
    "check:action-provenance": "node scripts/measure-action-provenance.mjs --check",
    "check:decisions": "node scripts/decision-index.mjs --check",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:figure-tables": "node scripts/check-figure-tables.mjs",
    "decisions:index": "node scripts/decision-index.mjs",
    "check:guidance": "node scripts/check-guidance.mjs",
    "check:guidance-links": "node scripts/check-guidance-links.mjs",
    "guidance:sql": "node scripts/run-guidance-sql.mjs",
    "measure:guidance-standard": "node scripts/measure-guidance-standard.mjs",
    "measure:sql-baseline": "node scripts/measure-sql-baseline.mjs",
    "measure:history-reads": "node --expose-gc --import tsx scripts/measure-history-reads.mts",
    "check:history-reads": "tsx scripts/measure-history-reads.mts --check",
    "measure:import-list": "node --import tsx scripts/measure-import-list.mts",
    "check:import-list": "node --import tsx scripts/measure-import-list.mts --check",
    "measure:retention-sweeps": "node --import tsx scripts/measure-retention-sweeps.mts",
    "check:retention-sweeps": "tsx scripts/measure-retention-sweeps.mts --check",
    "check:live-suite": "node scripts/live-suite.mjs --check",
    "store:census": "node --import tsx scripts/store-census.mts",
    "shape:record": "node --import tsx scripts/stored-shape.mts",
    "check:shape": "node --import tsx scripts/stored-shape.mts --check",
    "served:record": "node scripts/served.mjs --serving",
    "served:publish": "node scripts/served.mjs --publish",
    "check:served": "node scripts/served.mjs --check",
    "check:customer-journey": "node scripts/customer-journey.mjs --check",
    "customer-baselines:write": "TSX_TSCONFIG_PATH=tsconfig.client.json node --import tsx scripts/customer-baselines.mts --write",
    "customer-baselines:check": "TSX_TSCONFIG_PATH=tsconfig.client.json node --import tsx scripts/customer-baselines.mts --check",
    "baseline:accept": "node scripts/accept-baseline-durations.mjs",
    "record:awaiting": "node scripts/record-awaiting.mjs",
    "guidance:scaffold": "node scripts/scaffold-guidance.mjs",
    "schedule:principal": "node scripts/schedule-principal.mjs",
    "lifecycle": "node scripts/lifecycle.mjs",
    "recovery": "node scripts/recovery.mjs",
    "check:statement-bounds": "node scripts/check-statement-bounds.mjs",
    "check:grain": "tsx scripts/check-grain.mts",
    "check:unbound-calls": "tsx scripts/check-unbound-calls.mts",
    "check:sql-release": "node scripts/check-sql-release.mjs",
    "check:remediation": "node scripts/check-remediation.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:final-result-consumers": "node scripts/check-final-result-consumers.mjs",
    "check:audit-coverage": "node scripts/check-audit-coverage.mjs",
    "check:contained-handlers": "node scripts/check-contained-handlers.mjs",
    "check:coverage": "tsx scripts/check-coverage-ledger.mts",
    "check:judgment-routes": "tsx scripts/check-judgment-routes.mts",
    "check:thresholds": "tsx scripts/check-thresholds.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:viewport": "node scripts/check-viewport.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:drill": "node scripts/check-drill.mjs",
    "check:reveal": "node scripts/check-reveal.mjs",
    "check:guidance-fit": "node scripts/check-guidance-fit.mjs",
    "catalogue:version": "node scripts/catalogue-version.mjs --check",
    "catalogue:bump": "node scripts/catalogue-version.mjs --bump",
    "methodology:manifest": "tsx scripts/methodology-manifest.mts --write",
    "methodology:release": "tsx scripts/methodology-manifest.mts --release",
    "check:methodology-manifest": "tsx scripts/methodology-manifest.mts",
    "lockfile:check": "node scripts/lockfile-registry.mjs --check",
    "lockfile:fix": "node scripts/lockfile-registry.mjs --fix",
    "licences": "node scripts/check-licences.mjs",
    "third-party:licenses": "node scripts/third-party-licenses.mjs --write",
    "check:third-party-licenses": "node scripts/third-party-licenses.mjs",
    "check:shipped": "node scripts/check-shipped-bundle.mjs",
    "check:skill-vendoring": "node scripts/check-skill-vendoring.mjs",
    "drift:docs": "node scripts/docs-drift.mjs"
  },
  "keywords": [
    "databricks",
    "well-architected-framework",
    "assessment",
    "governance"
  ],
  "dependencies": {
    "@databricks/appkit": "0.57.0",
    "@databricks/appkit-ui": "0.65.0",
    "@databricks/lakebase": "0.5.0",
    "@databricks/sdk-experimental": "0.18.0",
    "@xyflow/react": "12.11.3",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "express": "5.2.1",
    "js-yaml": "5.4.0",
    "lucide-react": "1.34.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.45.2",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7",
    "js-yaml": "5.4.0",
    "@databricks/appkit": {
      "js-yaml": "4.3.1"
    },
    "@databricks/appkit-ui": {
      "yaml": "2.8.3"
    },
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "dompurify": "3.4.13",
    "gaxios": "7.3.0",
    "nanoid": "3.3.18"
  }
}
